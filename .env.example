# Copy to .env and fill in values. Never commit real secrets.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App JWT (long random string)
JWT_SECRET=

# Google Sign-In (same Client ID on both)
# Create an OAuth 2.0 Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://dayly-sage.vercel.app
# Authorized redirect URIs (GIS often needs the origin):
#   http://localhost:5173
#   https://dayly-sage.vercel.app
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Optional email (Brevo)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Dayly

# Optional cron
# CRON_SECRET=
